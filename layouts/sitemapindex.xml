{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Elenca solo le sitemap delle lingue con almeno una pagina indicizzabile:
       le lingue UE con la sola home noindex produrrebbero sitemap vuote. */}}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range . }}
    {{- $indicizzabili := 0 }}
    {{- range .Pages }}{{ if partial "is-indexable.html" . }}{{ $indicizzabili = add $indicizzabili 1 }}{{ end }}{{ end }}
    {{- if gt $indicizzabili 0 }}
  <sitemap>
    <loc>{{ .SitemapAbsURL }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </sitemap>
    {{- end }}
  {{- end }}
</sitemapindex>
